# ==========================================
# CONFIGURAÇÃO DE BANCO DE DADOS (PostgreSQL & pgvector)
# ==========================================
# Regra: Senhas inseridas em URLs não devem conter @, :, / ou #
POSTGRES_USER=spy_admin
POSTGRES_PASSWORD=defina_uma_senha_forte_aqui
POSTGRES_DB=mineracao_fb
STREAMLIT_DB_PASSWORD=defina_uma_senha_forte_aqui
PIPELINE_DB_PASSWORD=defina_uma_senha_forte_aqui
LIFECYCLE_DB_PASSWORD=defina_uma_senha_forte_aqui

# ==========================================
# REDIS BROKER
# ==========================================
REDIS_PASSWORD=defina_uma_senha_redis_aqui

# ==========================================
# ACESSO AOS PAINÉIS LOCAIS
# ==========================================
# Dashboard Streamlit e Flower (monitoramento Celery no formato usuario:senha)
DASHBOARD_PASSWORD=defina_uma_senha_forte_aqui
FLOWER_BASIC_AUTH=admin:defina_uma_senha_forte_aqui

# ==========================================
# INTEGRAÇÃO ANTI-DETECT (CDP)
# ==========================================
# Configuração da porta de depuração remota do navegador no host
CDP_HOST=host.docker.internal
CDP_PORT=9222

# ==========================================
# TOKENS E APIS EXTERNAS (GEMINI AI)
# ==========================================
# PASSO A PASSO - GEMINI API KEY:
# 1. Acesse o Google AI Studio (https://aistudio.google.com/apikey).
# 2. Crie uma nova chave de API (API Key).
# 3. Cole a chave gerada abaixo (ou opcionalmente salve no arquivo secrets/gemini/GEMINI_API_KEY).
GEMINI_API_KEY=sua_chave_google_ai_studio

# ==========================================
# ARMAZENAMENTO PERMANENTE (Cloudflare R2)
# ==========================================
# PASSO A PASSO - CLOUDFLARE R2:
# 1. Crie uma conta na Cloudflare (https://dash.cloudflare.com) e ative a subscrição do R2 Object Storage.
# 2. Na barra lateral esquerda do painel, copie o seu Account ID (código alfanumérico longo da URL/detalhes da conta).
# 3. Crie um bucket com o nome exato: minerador-criativos.
# 4. Vá em "Manage R2 API Tokens" e clique em "Create Account API Token".
#    - Defina permissões de "Object Read & Write" para o bucket minerador-criativos.
#    - Copie o Access Key ID gerado para CLOUDFLARE_R2_ACCESS_KEY.
#    - Copie o Secret Access Key gerado para CLOUDFLARE_R2_SECRET_KEY.
# 5. Nas definições (Settings) do bucket minerador-criativos, ative a opção "Public Development URL" (r2.dev).
# 6. Copie o URL público gerado e cole em CLOUDFLARE_R2_PUBLIC_URL.
#    (Opcionalmente, substitua cada variável pelo arquivo homônimo na pasta secrets/r2/).

CLOUDFLARE_R2_ACCOUNT_ID=seu_account_id
CLOUDFLARE_R2_ACCESS_KEY=sua_access_key
CLOUDFLARE_R2_SECRET_KEY=sua_secret_key
CLOUDFLARE_R2_BUCKET=minerador-criativos
CLOUDFLARE_R2_PUBLIC_URL=https://cdn.seudominio.com